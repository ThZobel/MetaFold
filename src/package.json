{
  "name": "metafold",
  "version": "0.0.2",
  "description": "MetaFold - Laboratory data management platform for automated folder structures, experiment metadata, and seamless integration with electronical lab notebooks like elabFTW and also OMERO. Built for life sciences research workflows.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThZobel/MetaFold.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "folder",
    "template",
    "structure",
    "project-management",
    "metadata",
    "experiments",
    "metafold",
    "visualization",
    "data-analysis"
  ],
  "author": "Dr. Thomas Zobel",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.thzobel.metafold",
    "productName": "MetaFold",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "css/**/*",
      "js/**/*",
      "components/**/*",
      "docs/**/*",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
